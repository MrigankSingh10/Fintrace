*.iml
*.ipr
*.iws

# Signing keys and certificates — NEVER commit
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
keystore.properties
signing.properties

# Secrets / local environment files
.env
.env.*
!.env.example
secrets.properties
secrets.xml

# Firebase / service configuration (keep local unless deliberately reviewed)
google-services.json
GoogleService-Info.plist

# Release artifacts / binaries
*.apk
*.aab
app/release/
outputs/

