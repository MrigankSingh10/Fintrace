*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.csv
*.xls
*.xlsx
*.backup
*.bak
exports/
backups/

# Logs / temporary files
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db

# Kotlin / Java tooling
.kotlin/

# Crash / profiling artifacts
captures/
.externalNativeBuild/

